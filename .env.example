# VenueFlow - Environment Configuration

# Server
PORT=3000
NODE_ENV=development

# PostgreSQL Database Configuration
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/venueflow
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=venueflow
PGSSL=false

# MongoDB Behavioral Tracking Database
MONGODB_URI=mongodb://localhost:27017/venueflow
MONGODB_DB_NAME=venueflow

# Authentication & Security
JWT_SECRET=venueflow-dev-secret-key-change-in-production-min32chars
JWT_EXPIRES_IN=7d
COOKIE_NAME=venueflow_token

# Business Logic Configuration
SEAT_HOLD_DURATION_MINUTES=10
WAITLIST_PROMOTION_EXPIRY_MINUTES=15
